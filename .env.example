# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here

# Mail (SMTP)
MAIL_USER=your-email@example.com
MAIL_PASS=your-smtp-password
MAIL_FROM=you@example.com
MAIL_TO=you@example.com

# Email API keys (резервные провайдеры)
RESEND_API_KEY=re_your-resend-key
UNISENDER_API_KEY=your-unisender-key

# Telegram bot (альтернатива файлам .tg_token / .tg_chat_id)
TG_TOKEN=your-bot-token
TG_CHAT_ID=your-chat-id

# Bitwarden CLI session (для работы bw serve)
BW_SESSION=

# DeepSeek CLI (для dev_runner)
DEEPSEEK_CMD=deepseek
